---
interface Props {
    class?: string;
    breakPoint?: "md" | "lg" | "xl" | "2xl";
}

const { class: className = "", breakPoint = "md" } = Astro.props;

/* ------------------------------
   🟦 BASE CLASSES (MOBILE)
------------------------------ */
const baseClasses = [
    "group relative h-full flex flex-col items-center justify-center",
    "transition-all duration-300 ease-out",
    "snap-center shrink-0",
    "focus:outline-none",

    // background móvil
    "bg-[linear-gradient(180deg,#00845f_0%,#014332_100%)]",

    // tamaño móvil
    "w-[200px] h-[155px]",
    "rounded-[30px]",

    // borde móvil
    "border-[5px] border-white",
].join(" ");

/* ------------------------------
   🟩 BREAKPOINT CLASSES
   (literales para que Tailwind
   las genere siempre)
------------------------------ */

const mdClasses = [
    "md:w-auto",
    "md:flex-1",
    "md:snap-align-none",
    "md:px-5",

    // fondo transparente
    "md:bg-[linear-gradient(180deg,transparent_0%,transparent_100%)]",

    // forma desktop
    "md:rounded-none",

    // bordes desktop
    "md:border-y-0",
    "md:border-l-0",
    "md:border-r-0",
    "md:border-transparent",
];

const lgClasses = [
    "lg:w-auto",
    "lg:flex-1",
    "lg:snap-align-none",
    "lg:px-5",
    "lg:bg-[linear-gradient(180deg,transparent_0%,transparent_100%)]",
    "lg:rounded-none",
    "lg:border-y-0",
    "lg:border-l-0",
    "lg:border-r-0",
    "lg:border-transparent",
];

const xlClasses = [
    "xl:w-auto",
    "xl:flex-1",
    "xl:snap-align-none",
    "xl:px-5",
    "xl:bg-[linear-gradient(180deg,transparent_0%,transparent_100%)]",
    "xl:rounded-none",
    "xl:border-y-0",
    "xl:border-l-0",
    "xl:border-r-0",
    "xl:border-transparent",
];

const xl2Classes = [
    "2xl:w-auto",
    "2xl:flex-1",
    "2xl:snap-align-none",
    "2xl:px-5",
    "2xl:bg-[linear-gradient(180deg,transparent_0%,transparent_100%)]",
    "2xl:rounded-none",
    "2xl:border-y-0",
    "2xl:border-l-0",
    "2xl:border-r-0",
    "2xl:border-transparent",
];

// Selección segura (sin strings dinámicos)
const bpMap = {
    md: mdClasses,
    lg: lgClasses,
    xl: xlClasses,
    "2xl": xl2Classes,
};
const selectedBP = (bpMap as any)[breakPoint].join(" ");
---

<div class:list={[baseClasses, selectedBP, className]}>
    <slot name="icon" />
    <slot name="description" />
</div>
