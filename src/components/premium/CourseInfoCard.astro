---
interface Props {
    title: string;
    description: string;
    class?: string;
}

const { title, description, class: className } = Astro.props;
---

<div
    class:list={[
        "bg-white rounded-[2rem] border-2 border-[#E1B16C] p-8 shadow-sm flex flex-col items-center text-center",
        className,
    ]}
>
    <h3 class="text-xl font-bold text-[#B28F5B] mb-4">{title}</h3>
    <p class="text-gray-500 font-medium leading-relaxed">{description}</p>
</div>
