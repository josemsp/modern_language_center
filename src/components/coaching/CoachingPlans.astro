---
// Carousel
import CarouselItem from "@/components/ui/simple-carousel/CarouselItem.astro";
import Carousel from "@/components/ui/simple-carousel/Carousel.astro";
import CoachingPlanItem from "./CoachingPlanItem.astro";
import SectionTitle from "../ui/SectionTitle.astro";

const plans = [
    {
        hours: 3,
        description:
            "Perfecto para un repaso rápido antes de tu próxima presentación o entrevista.",
    },
    {
        hours: 6,
        description:
            "Excelente para aquellos que deben desarrollar sus habilidades en varias sesiones.",
    },
    {
        hours: 12,
        description:
            "Nuestro plan más popular para aquellos que quieren dominar a fondo alguna habilidad en particular.",
    },
];
---

<section class="coaching-plans-background">
    <SectionTitle class="text-white text-center pt-14 pb-12 font-bold">
        Elige el mejor plan
    </SectionTitle>
    <Carousel class:list={["!mb-5 xl:hidden"]}>
        {
            plans.map((plan) => (
                <CarouselItem
                    dataLabel="Slide 1"
                    class="w-[340px] md:w-[478px]"
                    initialSlide={plan.hours === 6}
                >
                    <CoachingPlanItem
                        hours={plan.hours}
                        description={plan.description}
                    />
                </CarouselItem>
            ))
        }
    </Carousel>

    <div class:list={["hidden xl:flex", "flex-row justify-center gap-10 mb-7"]}>
        {
            plans.map((plan) => (
                <CoachingPlanItem
                    hours={plan.hours}
                    description={plan.description}
                />
            ))
        }
    </div>
    <p class="text-white text-center text-[20px] px-5 pb-10">
        Todos los planes incluyen sesiones con profesor en vivo.
    </p>
</section>

<style is:global>
    .coaching-plans-background {
        background: linear-gradient(179deg, #00845f, #014332);
    }
    @media (min-width: 1024px) {
        .carousel {
            gap: 2rem !important;
        }
    }
</style>
