---
interface Props {
    title: string;
    description: string;
    class?: string;
    titleClass?: string;
    descriptionClass?: string;
}

const {
    title,
    description,
    class: className,
    titleClass,
    descriptionClass,
} = Astro.props;
---

<div class:list={["space-y-0", className]}>
    <p class:list={["font-bold", titleClass]}>{title}</p>
    <p class:list={[descriptionClass]}>{description}</p>
</div>
