---
interface Props {
  ariaLabelledby: string;
  class?: string;
}

const { ariaLabelledby, class: className } = Astro.props;
---

<div role="tablist" aria-labelledby={ariaLabelledby} class={`automatic ${className}`} slot="tab-list">
  <div class="tab-bg bg-mlc-business-gradient"></div>
  <slot />
</div>
