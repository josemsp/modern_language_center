---
import TabList from "./TabList.astro";
import TabListItem from "./TabListItem.astro";
import TabPanel from "./TabPanel.astro";

interface Props {
  id?: string;
  class?: string;
  title?: string;
  showTitle?: boolean;
}

const {
  id = crypto.randomUUID(),
  class: className,
  title,
  showTitle = false,
} = Astro.props;
---

<div class={`simple-tabs ${className}`}>
  {showTitle && <h3 id={id}>{title}</h3>}
  <slot name="tab-list" />
  <slot />
