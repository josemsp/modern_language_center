---
interface Props {
  id?: string;
  heightToShow?: string;
  class?: string;
}

const {
  id = "show-more-" + crypto.randomUUID(),
  heightToShow = "75px",
  class: className,
} = Astro.props;
---

<div class={`show-more-content ${className}`}>
  <input type="checkbox" id={id} class="show-more-checkbox" />

  <div class="hidden-content" style={`max-height: ${heightToShow}`}>
    <slot />
  </div>
  <div class="fade-effect"></div>
  <label for={id} class="btn-show-more"></label>
</div>

<style>
  .show-more-content {
    position: relative;
    margin: 0 auto;
    background: #fff;
    overflow: hidden;
  }

  .show-more-checkbox {
    display: none;
  }

  .hidden-content {
    overflow: hidden;
    transition: max-height 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    font-size: 1.04rem;
    color: #5b6780;
    padding-top: 10px;
  }

  .fade-effect {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 45px;
    height: 130px;
    background: linear-gradient(
      0deg,
      rgba(255, 255, 255, 1) 0%,
      rgba(255, 229, 0, 0) 100%
    );
    pointer-events: none;
    transition: opacity 0.3s;
  }

  .btn-show-more {
    display: block;
    font-size: clamp(20px, 1.5vw, 1.13rem);
    background: none;
    border: none;
    color: #232323;
    font-weight: bold;
    cursor: pointer;
    text-align: center;
    padding-top: 36px;
  }

  .btn-show-more::after {
    content: "Mostrar más";
  }
  .show-more-checkbox:checked ~ .hidden-content {
    max-height: max-content !important;
  }
  .show-more-checkbox:checked ~ .fade-effect {
    opacity: 0;
  }
  .show-more-checkbox:checked ~ .btn-show-more::after {
    content: "Mostrar menos";
  }
</style>
