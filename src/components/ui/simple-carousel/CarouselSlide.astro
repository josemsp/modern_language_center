---
interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;
---

<div class={`carousel-slide ${className}`}>
  <slot />
</div>

<style>
  .carousel-slide {
    min-width: 85%;
    scroll-snap-align: center;
  }

  .carousel-slide:first-child {
    margin-left: 28px;
  }

  .carousel-slide:last-child {
    margin-right: 28px;
  }
</style>
