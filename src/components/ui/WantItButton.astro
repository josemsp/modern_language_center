---
interface Props {
  href?: string;
  class?: string;
  target?: string;
  rel?: string;
  disabled?: boolean;
  ariaLabel?: string;
}

const {
  href = "#",
  class: className = "",
  target,
  rel = target === "_blank" ? "noopener noreferrer" : undefined,
  disabled = false,
  ariaLabel,
} = Astro.props;
---

<a
  href={href}
  class:list={["font-bold text-white", `want-it-button w-[136px] h-[38px] xl:w-[163px] xl:h-[46px] ${className}`]}
  target={target}
  rel={rel}
  aria-label={ariaLabel}
  aria-disabled={disabled}
>
  <div class="slide">
    <div data-text="first-text">
      <slot name="first-text">Lo quiero</slot>
    </div>
  </div>
  <div data-text="second-text">
    <slot name="second-text">¡Cotizar ya!</slot>
  </div>
</a>

<style>
  .want-it-button {
    position: relative;
    text-decoration: none;
    border-radius: 30px;
    display: inline-flex;
    justify-content: center;
    align-items: center;
    overflow: hidden;
    transition: all 0.3s ease;
  }
  /* Business */
  .want-it-button.business {
    background-color: var(--color-want-it-button-business-hover);
  }
  /* Coaching */
  .want-it-button.coaching {
    background-color: var(--color-want-it-button-coaching-hover);
  }
  /* Premium */
  .want-it-button.premium {
    background-color: var(--color-want-it-button-premium-hover);
  }
  /* Meet */
  .want-it-button.meet {
    background-color: var(--color-want-it-button-meet-hover);
  }
  /* One */
  .want-it-button.one {
    background-color: var(--color-want-it-button-one-hover);
  }

  .want-it-button .slide {
    height: 100%;
    width: 100%;
    position: absolute;
    left: 0;
    top: 0;
    transition: left 0.6s ease;
    display: flex;
    justify-content: center;
    align-items: center;
    border-radius: 30px;
  }
  /* Business */
  .want-it-button.business .slide {
    background-color: var(--color-want-it-button-business);
  }
  /* Coaching */
  .want-it-button.coaching .slide {
    background-color: var(--color-want-it-button-coaching);
  }

  /* Premium */
  .want-it-button.premium .slide {
    background-color: var(--color-want-it-button-premium);
  }

  /* Meet */
  .want-it-button.meet .slide {
    background-color: var(--color-want-it-button-meet);
  }

  /* One */
  .want-it-button.one .slide {
    background-color: var(--color-want-it-button-one);
  }

  .want-it-button:hover .slide {
    left: -100%;
  }

  .want-it-button [data-text="second-text"] {
    width: 100%;
    height: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
    transform: scale(0);
    transition: transform 0.3s ease-in-out;
  }

  .want-it-button:hover [data-text="second-text"] {
    transform: scale(1);
  }

  /* Mejoras de accesibilidad */
  .want-it-button:focus {
    /* outline: 2px solid var(--color-button-mlc-blue, #1d4ed8); */
    outline-offset: 2px;
  }

  /* Mejora de rendimiento con transform en lugar de left */
  @media (prefers-reduced-motion: reduce) {
    .want-it-button,
    .want-it-button * {
      transition-duration: 0.05ms !important;
    }
  }
</style>
