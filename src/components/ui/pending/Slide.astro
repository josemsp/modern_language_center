---
interface SlideData {
  id: number;
  title: string;
  category: string;
  shortDescription: string;
  longDescription: string;
  imageUrl: string;
}

interface Props {
  data: SlideData;
  isActive: boolean;
  id?: string;
}

const { data, isActive, id } = Astro.props;
---

<div
  class={`transition-all duration-500 ease-out transform ${isActive ? 'opacity-100 scale-100' : 'opacity-60 scale-90'}`}
  id={id}
>
  <div class="bg-gray-800 rounded-lg shadow-2xl overflow-hidden">
    <img
      src={data.imageUrl}
      alt={data.title}
      class="w-full aspect-video object-cover"
    />
    <div class="p-6 md:p-8 flex flex-col">
      <span class="text-indigo-400 text-sm font-semibold uppercase tracking-wider">{data.category}</span>
      <h3 class="text-2xl lg:text-3xl font-bold text-white mt-2">{data.title}</h3>
      <p class="text-gray-400 mt-4 text-base leading-relaxed">{data.shortDescription}</p>

      <div
        id={`expand-content-${data.id}`}
        class="transition-all duration-700 ease-in-out overflow-hidden max-h-0 opacity-0"
      >
        <p class="text-gray-400 text-base leading-relaxed pt-4">{data.longDescription}</p>
      </div>

      <div class="mt-auto pt-6">
        <button
          class="text-indigo-400 hover:text-indigo-300 font-semibold transition-colors duration-200"
          onclick={`toggleExpand(${data.id})`}
        >
          Mostrar más
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  function toggleExpand(slideId: number) {
    const button = document.querySelector(`[onclick="toggleExpand(${slideId})"]`) as HTMLButtonElement;
    const expandContent = document.getElementById(`expand-content-${slideId}`);

    if (!expandContent) return;

    const isExpanded = expandContent.classList.contains('max-h-96') && expandContent.classList.contains('opacity-100');

    if (isExpanded) {
      expandContent.classList.remove('max-h-96', 'opacity-100');
      expandContent.classList.add('max-h-0', 'opacity-0');
      button.textContent = 'Mostrar más';
    } else {
      expandContent.classList.remove('max-h-0', 'opacity-0');
      expandContent.classList.add('max-h-96', 'opacity-100');
      button.textContent = 'Mostrar menos';
    }
  }

  // Exponer la función globalmente para que pueda ser llamada desde otros componentes
  (window as any).toggleExpand = toggleExpand;
</script>
