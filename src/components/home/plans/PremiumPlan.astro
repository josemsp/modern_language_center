---
import LogoMLC from "@/assets/icons/LogoMLC.astro";
import ShowMore from "@/components/ui/ShowMore.astro";
import WantItButton from "@/components/ui/WantItButton.astro";

interface Props {
  class?: string;
}

const { class: className = "" }: Props = Astro.props;

const benefits = [
  "Ejecutivos de alto nivel que presentan, negocian o lideran en inglés.",
  "Individual.",
  "4 horas a la semana, intensivo.",
  "Curso completo de 72 hrs.",
  "wantItButton",
  "Solo disponible para inglés y portugués.",
  "Pago mensual o por módulo. Sin costo de inscripción.",
  "Profesor en vivo (online).",
  "Libro no incluido. Padlet incluido.",
  "Examen de certificación gratis. Intermedio o avanzado. Si quieres perfeccionar.",
  "Preparación intensiva enfocada en resultados rápidos.",
  "Clase muestra sin costo.",
];
---

<div class:list={["rounded-lg shadow-3xl overflow-hidden text-xl", className]}>
  <!-- Header logo -->
  <div class="plan-logo-container bg-mlc-premium-gradient pb-7 xl:pb-5">
    <LogoMLC id="mlc-premium-white" class="w-[198px] xl:w-[250px]" />
  </div>

  <!-- Content -->
  <div class="md:p-8 flex flex-col plan-card py-5 px-4 relative xl:h-[955px]">
    <ShowMore heightToShow="485px" fadeHeight="130px" class="xl:hidden">
      <ul class="plan-benefits premium separate text-[#4D4D4D]">
        {
          benefits.map((benefit) =>
            benefit === "wantItButton" ? (
              <li class="no-arrow">
                <div class="w-full flex flex-col items-center gap-2">
                  <p class="w-[180px] text-xl font-bold text-center text-[#2D2D2D]">
                    Sólo los módulos que necesitas
                  </p>
                  <WantItButton class="premium" href="/es/premium" />
                </div>
              </li>
            ) : (
              <li>{benefit}</li>
            ),
          )
        }
      </ul>
    </ShowMore>
    <div class="hidden w-full xl:block">
      <ul class="plan-benefits premium text-[#4D4D4D]">
        {
          benefits.map((benefit) =>
            benefit === "wantItButton" ? (
              <li class="no-arrow">
                <div class="w-full flex flex-col items-center gap-2">
                  <p class="w-[180px] text-xl font-bold text-center text-[#2D2D2D]">
                    Sólo los módulos que necesitas
                  </p>
                  <WantItButton class="premium" href="/es/premium" />
                </div>
              </li>
            ) : (
              <li>{benefit}</li>
            ),
          )
        }
      </ul>
    </div>
  </div>

  <!-- Footer -->
  <div
    class="plan-footer bg-[var(--color-mlc-premium-dark)]/80 hover:bg-[var(--color-mlc-premium-dark)]"
  >
    <p>Más información</p>
  </div>
</div>
