---
import MeetIconWhite from "@/assets/icons/mlc-meet-white.svg";
import ShowMore from "@/components/ui/ShowMore.astro";
import WantItButton from "@/components/ui/WantItButton.astro";
import PlanContainerInfo from "./PlanContainerInfo.astro";
---

<PlanContainerInfo backgroundColor="#CCCCCC" textColor="#4D4D4D" header="Inglés desde cualquier nivel">
  <div class="rounded-lg shadow-3xl overflow-hidden text-xl">
    <!-- Header logo -->
    <div class="plan-logo-container bg-mlc-meet-gradient">
      <MeetIconWhite class="w-[168px] pt-2 pb-8" />
    </div>

    <!-- Content -->
    <div class="md:p-8 flex flex-col plan-card py-5 px-4 relative">
      <ShowMore heightToShow="485px" fadeHeight="130px" class="">
        <ul class="plan-benefits meet text-[#4D4D4D]">
          <li>
            Profesionales jóvenes que buscan crecer o entrar a empresas
            globales.
          </li>
          <li>Grupal (máximo 10 personas).</li>
          <li>Horario fijo (Martes, Miércoles, Jueves 1 hr o 3 hrs sábado).</li>
          <li>Cursos de 2.5 meses o 10 semanas (12 niveles).</li>
          <li class="no-arrow">
            <div class="w-full flex flex-col items-center gap-2">
              <div class="flex gap-2 text-center text-[#2D2D2D]">
                <span class="font-bold text-[30px] lg:text-[45px]">
                  $1,595
                </span>
                <span class="text-[20px] lg:text-[24px]">/mes</span>
              </div>
              <WantItButton class="meet" />
            </div>
          </li>
          <li>Solo disponible para inglés.</li>
          <li>
            Bajo costo. Pago mensual o por módulo. Sin costo de inscripción.
          </li>
          <li>Profesor en vivo (online).</li>
          <li>Material incluido.</li>
          <li>Examen de certificación gratis.</li>
          <li>Puedes iniciar desde cero o desde tu nivel actual.</li>
          <li>Inglés de negocios a precio super accesible. Grupos reducido.</li>
        </ul>
      </ShowMore>
    </div>

    <!-- Footer -->
    <div
      class="plan-footer bg-[var(--color-mlc-meet-dark)]/80 hover:bg-[var(--color-mlc-meet-dark)]"
    >
      <p>Más información</p>
    </div>
  </div>
</PlanContainerInfo>
