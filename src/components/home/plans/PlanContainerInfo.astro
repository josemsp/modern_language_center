---
interface Props {
  class?: string;
  header?: string;
  textColor?: string;
  backgroundColor?: string;
}

const { class: className, header, textColor, backgroundColor } = Astro.props;
---

<div class="relative">
  <div
    class:list={[
      "plan-container-info",
      "transition-all duration-200 ease-in-out",
      className,
    ]}
    tabindex="0"
    data-header={header}
    style={`--text-color: ${textColor || '#0000'}; --bg-color: ${backgroundColor || 'transparent'}`}
  >
    <slot />
  </div>
</div>

<style is:global>
  .plan-container-info {
    display: inline-block;
    position: relative;
    transition: all 0.2s ease-in-out;
    z-index: 1;

    /* Transiciones con diferentes duraciones para efecto escalonado */
    transition:
      background-color 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94),
      border-radius 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94),
      padding 0.35s cubic-bezier(0.25, 0.46, 0.45, 0.94),
      margin 0.35s cubic-bezier(0.25, 0.46, 0.45, 0.94),
      transform 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94),
      z-index 0s 0.2s; /* Delay para z-index */

    /* Estado inicial del pseudo-elemento */
    &::before {
      content: attr(data-header);
      position: relative;
      display: flex;
      align-items: center;
      justify-content: center;
      text-align: center;
      height: 0;
      overflow: hidden;
      opacity: 0;
      font-size: 17px;
      color: var(--text-color);
      padding-bottom: 0;
      transform: translateY(-10px);

      /* Animación con retraso para efecto cascada */
      transition:
        height 0.35s cubic-bezier(0.25, 0.46, 0.45, 0.94),
        opacity 0.25s cubic-bezier(0.25, 0.46, 0.45, 0.94) 0.1s,
        transform 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94) 0.1s,
        padding 0.35s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    }
  }

  /* Estado cuando está snapped en el carousel */
  @supports (container-type: scroll-state) {
    .carousel__slide {
      container-type: scroll-state;
    }

    /* Cuando el slide está snapped (centrado) */
    @container scroll-state(snapped: inline) {
      .plan-container-info {
        position: relative;
        z-index: 2;
        background: var(--bg-color);
        border-radius: 25px;
        padding: 12px 12px 12px 12px;
      }

      .plan-container-info::before {
        height: 40px;
        opacity: 1;
        transform: translateY(0);
        padding-bottom: 10px;
      }
    }
  }
</style>
