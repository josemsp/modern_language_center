---
import MLCBusinessBlack from "@/assets/icons/mlc-business-black.svg";
import CoachingWhite from "@/assets/icons/mlc-coaching-white.svg";
import Button from "../ui/Button.astro";
import ShowMore from "../ui/ShowMore.astro";
import { languages } from "@/constants";
import PlanContainer from "./plan/PlanContainer.astro";
// import Tabs from "../ui/tabs/Tabs.astro";
// import TabList from "../ui/tabs/TabList.astro";
// import TabTrigger from "../ui/tabs/TabTrigger.astro";
// import TabPanel from "../ui/tabs/TabPanel.astro";
// import Carousel from "../ui/Carousel.astro";
import CarouselSlide from "../ui/simple-carousel/CarouselSlide.astro";
import Carousel from "../ui/simple-carousel/Carousel.astro";
import WantItButton from "../ui/WantItButton.astro";
import Tabs from "../ui/tabs/Tabs.astro";
import Tab from "../ui/tabs/Tab.astro";

import SimpleTabs from "../ui/simple-tabs/Tabs.astro";
import TabList from "../ui/simple-tabs/TabList.astro";
import TabListItem from "../ui/simple-tabs/TabListItem.astro";
import TabPanel from "../ui/simple-tabs/TabPanel.astro";

import Carousel1 from "../ui/pending/Carousel1.astro";
// import Slider from "../ui/pending/S1";
import SliderNew from "../ui/pending/SliderNew.astro";
import Slider from "../ui/pending/Slider.astro";
import Caro from "../ui/pending/Caro.astro";
import CarouselItem from "../ui/pending/CarouselItem.astro";
---

<section class="plans">
  <section class:list={["plans-header pt-8 flex flex-col items-center gap-3"]}>
    <h2 class="subtitle w-[228px]">Planes para ti o tu equipo</h2>
    <p class="text-4xl tracking-normal">
      Soluciones integrales en idiomas adaptadas a tus necesidades, nivel de
      servicio y calidad que demandan todos nuestros clientes.
    </p>
  </section>

  <SimpleTabs id="tab-plans" class="mt-5" title="Planes para ti o tu equipo">
    <TabList ariaLabelledby="tab-plans" class="flex justify-center">
      <div class="custom-tab-list w-[324px]">
        <TabListItem
          id="tab-companies"
          ariaControls="tabpanel-companies"
          class="custom-tab-item bg-mlc-blue-gradient"
        >
          Empresas
        </TabListItem>
        <TabListItem
          id="tab-individuals"
          ariaControls="tabpanel-individuals"
          class="custom-tab-item bg-mlc-blue-gradient"
        >
          Individuales
        </TabListItem>
      </div>
    </TabList>

    <TabPanel
      id="tabpanel-companies"
      aria-labelledby="tab-companies"
      class="pt-9"
    >
      <Caro>
        <CarouselItem dataLabel="Slide 1">
          <div class="rounded-lg shadow-2xl overflow-hidden text-xl">
            <div class="plan-logo-container bg-mlc-green-gradient">
              <CoachingWhite class="w-[168px] pt-2 pb-8" />
            </div>

            <div class="md:p-8 flex flex-col plan-card py-5 px-4 relative">
              <div
                class={`expand-content-${1} transition-all duration-700 ease-in-out overflow-hidden max-h-[540px]`}
              >
                <ul class="plan-benefits green text-[#4D4D4D]">
                  <li>
                    Quienes ya dominan el idioma pero necesitan pulirlo para un
                    evento específico.
                  </li>
                  <li>Individual.</li>
                  <li>Paquetes de 6 a 24 hrs.</li>
                  <li>Flexible según necesidad puntual.</li>
                  <li class="no-arrow">
                    <div class="w-full flex flex-col items-center gap-2">
                      <p
                        class="w-[174px] text-xl font-bold text-center text-[#2D2D2D]"
                      >
                        Paga solo las horas que quieras
                      </p>
                      <WantItButton class="blue" />
                    </div>
                  </li>
                  <li>
                    Disponible para inglés, portugués, francés, alemán e
                    italiano y español para extranjeros.
                  </li>
                  <li>
                    Pago por paquete (según horas contratadas). Sin costo de
                    inscripción.
                  </li>
                  <li>Profesor en vivo (online).</li>
                  <li>Material personalizado incluido.</li>
                  <li>Examen de certificación gratis.</li>
                  <li>
                    Para nivel intermedio en adelante. Lo necesitas dominar para
                    evento.
                  </li>
                  <li>Fluidez inmediata para hablar en público con impacto.</li>
                </ul>
              </div>

              <div class="fade-effect"></div>
              <div class="mt-auto py-6 relative w-full flex justify-center">
                <button
                  class={`toggle-button-${1} duration-200 font-bold absolute bottom-0`}
                  onclick={`toggleExpand(${1})`}
                >
                  Mostrar más
                </button>
              </div>
            </div>
            <div class="plan-footer bg-[#006C4C]">
              <p>Más información</p>
            </div>
          </div>
        </CarouselItem>
        <CarouselItem dataLabel="Slide 2" initialSlide class="w-[343px]">
          <div class="rounded-lg shadow-2xl overflow-hidden text-xl">
            <div class="plan-logo-container bg-mlc-green-gradient">
