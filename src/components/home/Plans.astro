</div>
<style is:global>
  .custom-tab-list {
    /* min-w-[324px] max-w-[576px] h-[44px] rounded-full border-1 border-gray-300 bg-white */
    /* min-width: 324px;
    max-width: 576px; */
    height: 44px;
    border-radius: 25px;
    border: 1px solid #e5e7eb;
    background-color: #fff;
    padding-inline: 4px;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .custom-tab-item {
    /*  rounded-full bg-mlc-blue-gradient w-[158px] h-[33px] aria-selected:text-white font-bold m-1 */
    border-radius: 25px;
    background-color: #3c88f6;
    width: 158px;
    height: 33px;
    font-weight: bold;
    margin: 1px;
  }
  .custom-tab-item[aria-selected="true"] {
    color: white;
  }
  .custom-tab-item[aria-selected="false"] {
    background: none;
  }
</style>
<style>
  .plans-header {
    * {
      text-align: center;
    }
    p {
      font-size: clamp(20px, 2vw, 2rem);
    }
  }

  /* .tabs nav {
    button {
      font-size: clamp(20px, 2vw, 2rem);
      margin: 0;
      border: none;
    }
  } */

  .tab-panel {
    margin-top: 30px;
    width: 100%;
    padding: 0 2rem;
    /* margin: 0 auto; */
  }

  .card {
    border-radius: 25px;
    border-width: 0;
  }

  .languages {
    column-count: 2;
    column-gap: 38px;
    list-style: disc;
    padding-left: 1.3rem;
    margin-bottom: 0.5rem;

    li::marker {
      margin-right: 10px;
      font-size: 22px;
      color: #3c88f6;
      font-weight: 700;
    }
  }

  .plan-benefits {
    line-height: 1.5em;
    list-style: none;
    padding-left: 0;
    letter-spacing: 0;

    li {
      color: black;
