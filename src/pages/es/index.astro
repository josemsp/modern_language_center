---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/header/index.astro";
import Button from "@/components/ui/Button.astro";
import Home from "@/features/home.astro";
import Footer from "@/layouts/Footer.astro";
import SectionTitle from "@/components/ui/SectionTitle.astro";

const lang = Astro.currentLocale || "es";
---

<Layout lang={lang} title="Home - Modern Language Center" description="">
  <Header slot="header" />
  <Home />

  <Footer slot="footer" textColor="#7FD6FC" class="bg-mlc-business-gradient">
    <section
      slot="header-footer"
      class="pt-8 xl:pt-20 pb-24 flex flex-col items-center gap-5"
    >
      <SectionTitle class="text-white w-[330px] lg:w-[870px] text-center">
        ¿Cómo podemos ayudarte?
      </SectionTitle>
      <p class="text-white text-xl xl:text-[36px] text-center px-8">
        ¡Preparemos tu solución lingüística personalizada ahora!
      </p>
      <Button
        class="btn-contact text-xl xl:text-[25px] w-40 font-bold xl:w-[224px] xl:h-[64px] xl:mt-5"
      >
        Contáctanos
      </Button>
    </section>
  </Footer>
</Layout>
