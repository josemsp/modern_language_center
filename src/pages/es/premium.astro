---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/header/index.astro";
import PremiumView from "@/features/premium.astro";
import Footer from "@/layouts/Footer.astro";

const lang = Astro.currentLocale || "es";
---

<Layout lang={lang} title="Home - Modern Language Center" description="">
    <Header slot="header" />
    <PremiumView />

    <Footer
        slot="footer"
        textColor="#EDD38D"
        class="bg-[linear-gradient(179deg,var(--color-mlc-premium-light)_0%,var(--color-mlc-premium-dark)_100%)] pt-20"
    />
</Layout>
