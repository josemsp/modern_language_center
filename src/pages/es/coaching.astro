---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/header/index.astro";
import Button from "@/components/ui/Button.astro";
import CoachingView from "@/features/coaching.astro";
import Footer from "@/layouts/Footer.astro";
import SectionTitle from "@/components/ui/SectionTitle.astro";

const { lang = "es" } = Astro.params;
---

<Layout lang={lang} title="Home - Modern Language Center" description="">
  <Header slot="header" />
  <CoachingView />

  <Footer
    slot="footer"
    textColor="#59DFB7"
    class="bg-[linear-gradient(179deg,var(--color-mlc-coaching-light)_0%,var(--color-mlc-coaching-dark)_100%)] pt-20"
  />
</Layout>
