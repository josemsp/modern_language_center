---
export interface Props {
    class?: string;
    title?: string;
    id?: string;
}

const {
    class: className = "",
    title = "Modern Language Center",
    id = "mlc-one-white",
} = Astro.props;
---

<svg class={className} viewBox="0 0 400 191.73" role="img" aria-label={title}>
    <title>{title}</title>
    <use href={`#${id}`}></use>
</svg>
