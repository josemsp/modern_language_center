---
// Images
import ModerBlack from "@/assets/images/mlc-black.png";
import MeetImage1 from "@/assets/images/meet/MLC_Meet_01.png";
import MeetImage2 from "@/assets/images/meet/MLC_Meet_02.png";
// Icons
import LogoMLC from "@/assets/icons/LogoMLC.astro";
import EfectivoIcon from "@/assets/icons/meet/Efectivo.svg";
import PersonalizadoIcon from "@/assets/icons/meet/Personalizado.svg";
import MaximizaIcon from "@/assets/icons/meet/Maximiza.svg";
import EspecializadoIcon from "@/assets/icons/meet/Especializado.svg";
import TrackTestIcon from "@/assets/icons/Tracktest.svg";
// Components
import Container from "@/components/ui/Container.astro";
import SectionTitle from "@/components/ui/SectionTitle.astro";
import SpeechBubble from "@/components/ui/SpeechBubble.astro";
import WantItButton from "@/components/ui/WantItButton.astro";
// Types
import type { ContentItemDescriptionsType } from "@/types";
import LevelContainer from "@/components/meet/LevelContainer.astro";
import Button from "@/components/ui/Button.astro";
import MLCForm from "@/components/ui/MLCForm.astro";

const DESCRIPTION_ITEMS = [
  "Clases con profesor online en vivo",
  "Equipo global de instructores",
  "Examen de colocación con certificado oficial",
  "Mensualidad de $1,595",
  "Grupos reducidos (10 máximo)",
  "Material didáctico especializado en negocios incluido",
];

interface BenefitsItemType extends ContentItemDescriptionsType {
  icon: any;
}

const BENEFITS_ITEMS: BenefitsItemType[] = [
  {
    icon: PersonalizadoIcon,
    title: "Personalizado",
    description: [
      "Siempre adaptando y escuchando tus necesidades profesionales reales.",
    ],
  },
  {
    icon: EfectivoIcon,
    title: "Efectivo",
    description: [
      "Los profesores adaptan y personalizan su estilo de enseñanza a tu estilo de aprendizaje.",
      "Asesoría y análisis continuos de tu progreso.",
    ],
  },
  {
    icon: EspecializadoIcon,
    title: "Especializado",
    description: [
      "Material didáctico con contenido aplicable a todas las industrias de negocios.",
      "Los profesores te comparten contenidos para reforzar conceptos: imágenes, videos, presentaciones, PDF's.",
    ],
  },
  {
    icon: MaximizaIcon,
    title: "Maximiza tu tiempo",
    description: ["Horarios pensados para profesionales ocupados."],
  },
];

const PLAN_LEVELS = [
  {
    name: "principiante",
    level1: "A1",
    level2: "A2",
  },
  {
    name: "intermedio",
    level1: "B1",
    level2: "B2",
  },
  {
    name: "avanzado",
    level1: "C1",
    level2: "C2",
  },
];
const totalPlanLevels = PLAN_LEVELS.length;

const SCHEDULES = [
  {
    days: "Martes y jueves",
    hours: "de 7 a 8pm/ 8 a 9pm (1 hora)",
  },
  {
    days: "Sábados",
    hours: "de 9 a 12 pm (3 horas)",
  },
];
---

<section class="relative w-full text-[#2D2D2D] bg-[#E4E4E4]">
  <section
    class="bg-[linear-gradient(180deg,var(--color-mlc-meet-light)_0%,var(--color-mlc-meet-dark)_100%)] relative"
  >
    <Container
      class:list={[
        "relative pt-[80px] flex justify-center items-start h-[900px] overflow-hidden",
        "xl:h-[1000px] xl:pt-[100px] xl:text-left xl:leading-normal",
      ]}
    >
      <div
        class:list={[
          "flex flex-col items-center gap-3 text-center w-full pt-12 leading-[1] text-white relative z-10 mx-5",
          "xl:justify-center xl:items-start xl:text-left xl:leading-normal xl:pt-[200px]",
        ]}
      >
        <h1
          class="text-[60px] font-black xl:text-[90px] max-w-[940px] flex flex-col xl:leading-[1] tracking-tight"
        >
          <span class="text-[60px] font-black text-[#D7A0FF] xl:text-[90px]">
            Curso de ingles online
          </span>
          <span>con profesor en vivo</span>
        </h1>

        <div class="flex items-center gap-3">
          <div class="text-[20px] text-[#D7A0FF] text-right xl:text-left">
            <p class="">Fecha de inicio</p>
            <p class="font-black">22 de septiembre</p>
          </div>
          <p class="flex gap-2 text-center text-white items-baseline">
            <span class="font-bold text-[40px] lg:text-[45px]">$1,595</span>
            <span class="text-[20px] lg:text-[24px]">/mes</span>
          </p>
        </div>
        <WantItButton class="meet mt-5" />
      </div>

      <img
        src={MeetImage1.src}
        alt=""
        class:list={[
          "absolute z-0 bottom-0 w-full h-auto max-w-[430px] max-h-[500px] scale-[1.6] origin-bottom",
          "xl:right-[200px] xl:max-w-[630px] xl:max-h-[800px] xl:scale-[1.9]",
          "2xl:right-[340px] 2xl:scale-[2.3]",
        ]}
      />
    </Container>
  </section>

  <section class="bg-[#E4E4E4] flex flex-col items-center py-15">
    <Container class="xl:px-20">
      <div class:list={["flex flex-col px-10", "lg:flex-row-reverse lg:px-24"]}>
        <div class="px-5">
          <SectionTitle
            class="w-full text-center text-[#8249B8] pb-4 font-black italic"
          >
            ¿Te sientes identificado con alguna de estas?
          </SectionTitle>
          <SpeechBubble
            align="right"
            class="w-full max-w-[280px] xl:max-w-[604px]"
          >
            <p
              class="text-[#8249B8] font-black text-[20px] tracking-tight xl:text-[40px]"
            >
              “Vi una vacante perfecta, pero pedían inglés”
            </p>
          </SpeechBubble>
          <SpeechBubble
            align="left"
            class="w-full max-w-[300px] xl:max-w-[604px]"
          >
            <p
              class="text-[#8249B8] font-black text-[20px] tracking-tight xl:text-[40px]"
            >
              “Trabajo todo el día, ¿a qué hora voy a aprender inglés?”
            </p>
          </SpeechBubble>
          <SpeechBubble
            align="right"
            class="w-full max-w-[332px] xl:max-w-[604px]"
          >
            <p
              class="text-[#8249B8] font-black text-[20px] tracking-tight xl:text-[40px]"
            >
              “Sé algo de inglés… pero no me siento listo para una entrevista”.
            </p>
          </SpeechBubble>
        </div>

        <div class="w-full flex justify-center items-end z-20 lg:max-w-[450px]">
          <img
            src={MeetImage2.src}
            alt=""
            class:list={[
              "object-contain object-bottom w-full max-w-[250px]",
              "xl:max-w-[618px] xl:h-[850px]",
            ]}
          />
        </div>
      </div>

      <div
        class:list={[
          "bg-[#52137E] w-full max-w-[500px] mx-auto font-bold italic border-white text-white",
          "flex flex-col justify-between items-center px-5 text-[20px]",
          "xs:flex-row xs:border-[5px] xs:rounded-[58px]",
          "md:rounded-[58px]",
          "lg:max-w-[1480px] lg:h-[202px] lg:text-[60px] lg:justify-center lg:gap-10",
        ]}
      >
        <p>Entonces</p>
        <LogoMLC
          id="mlc-meet-white"
          class="w-full max-w-[150px] lg:max-w-[360px]"
        />
        <p>es para ti</p>
      </div>

      <div class="px-5 w-full max-w-[1480px] mx-auto">
        <SectionTitle
          class="w-full text-center text-[#A679D0] pt-[71px] pb-4 font-black italic tracking-tight"
        >
          Una solución efectiva y accesible desde cualquier lugar
        </SectionTitle>

        <ul class="description-list text-[20px] leading-[1] lg:text-[36px]">
          {DESCRIPTION_ITEMS.map((item) => <li>{item}</li>)}
        </ul>
      </div>
    </Container>
  </section>

  <section
    class:list={[
      "bg-[linear-gradient(180deg,var(--color-mlc-meet-light)_0%,var(--color-mlc-meet-dark)_100%)]",
      "py-12",
    ]}
  >
    <Container class:list={["relative flex flex-col gap-7 px-5"]}>
      <div
        class:list={["text-center w-full leading-[1] text-white relative z-10"]}
      >
        <SectionTitle class="text-[white]">
          ¿Qué
          <span class="font-black text-[#D8A0FF]"> beneficios </span>
          obtendrás?
        </SectionTitle>
      </div>

      <ul class="benefits-list">
        {
          BENEFITS_ITEMS.map((item) => (
            <li class:list={["flex flex-row gap-5 text-[20px] text-white"]}>
              <item.icon class="w-full max-w-[33px] h-[33px] text-[#D8A0FF] xl:max-w-[54px] xl:h-[54px]" />
              <div>
                <h1 class="text-[#D8A0FF] font-bold text-[20px] xl:text-[30px]">
                  {item.title}
                </h1>
                {item.description.map((description) => (
                  <p class="text-[20px] xl:text-[26px]">{description}</p>
                ))}
              </div>
            </li>
          ))
        }
      </ul>
    </Container>
  </section>

  <section
    class="bg-[#E4E4E4] flex flex-col items-center pt-15 overflow-hidden"
  >
    <SectionTitle
      class="w-full text-center pt-[71px] pb-4 font-black italic px-5"
    >
      Aprendemos con base en objetivos claros, medibles y alcanzables
    </SectionTitle>

    <div class="relative w-full">
      <div class="flex flex-col gap-5">
        <div class="w-[2350px] h-[500px] mx-auto">
          <div
            class="triangle-rotate ml-[-20rem] lg:ml-[-15rem] xl:ml-[-25rem] 2xl:ml-[-7rem]"
          >
          </div>
        </div>
      </div>

      <div class="absolute left-0 bottom-0 w-full h-full overflow-x-auto">
        <div
          class="relative grid grid-cols-3 min-w-[450px] h-full max-w-[1750px] mx-auto items-end pt-4"
        >
          {
            PLAN_LEVELS.map((info, i) => (
              <LevelContainer
                {...info}
                isLast={i + 1 === totalPlanLevels}
                class:list={[
                  i == 1 &&
                    "mb-[2rem] xs:mb-[3rem] sm:mb-[4rem] md:mb-[5rem] 2xl:mb-[6rem]",
                  i == 2 &&
                    "mb-[4rem] xs:mb-[5rem] sm:mb-[7rem] md:mb-[8rem] lg:mb-[9rem] xl:mb-[10rem] 2xl:mb-[12rem]",
                ]}
              />
            ))
          }
          <Button
            label="Teacher Login"
            class:list={[
              "bg-[#BF7CE2] rounded-[calc(16px+30px)] w-[178px] h-[43px] text-[20px] absolute bottom-[2%] right-[2%]",
              "xl:text-[25px] xl:w-[252px] xl:h-[63px] lg:bottom-[10%] lg:right-[10%]",
            ]}
            variant="default"
            size="md"
          >
            Ver trayectoria
          </Button>
        </div>
      </div>
    </div>
  </section>

  <Container class="bg-[#E4E4E4] flex flex-col items-center pt-5 px-5 xl:px-0">
    <p class="text-[20px] text-center">
      MCER: Marco Común Europeo de Referencia para las lenguas
    </p>
    <div class="flex justify-around items-center w-full max-w-[1000px] mx-auto">
      <TrackTestIcon class="w-[200px] xl:w-[350px]" />
      <img
        src={ModerBlack.src}
        alt="Modern Language Center - Logo"
        class="w-[150px] xl:w-[250px] h-[55px] xl:h-[90px]"
      />
    </div>

    <div class="my-14 grid grid-cols-1 items-center lg:grid-cols-[40%_60%]">
      <SectionTitle class="text-center font-bold col-span-1 lg:text-left">
        Consulta el inicio del curso y horarios disponibles
      </SectionTitle>

      <div
        class:list={[
          "grid grid-cols-2 lg:grid-cols-[40%_28%_32%] w-full lg:max-w-[900px] bg-white rounded-[2rem] overflow-hidden col-span-1",
          "text-[20px] justify-self-end",
        ]}
      >
        {/* 1. Header: Preinscripción */}
        {/* Mobile: Order 1 (Top) | Desktop: Order 1 (Top Left) */}
        <div
          class="col-span-2 lg:col-span-1 order-1 bg-[#9b36d0] text-white flex items-center justify-center py-2.5 lg:py-4"
        >
          <h1 class="font-bold tracking-wide">Preinscripción</h1>
        </div>

        {/* 2. Content: Start Date */}
        {/* Mobile: Order 2 (Below Header) | Desktop: Order 4 (Row 2, Col 1) */}
        <div
          class="col-span-2 lg:col-span-1 order-2 lg:order-4 bg-white text-center flex items-center justify-center py-5 lg:py-4 px-4 lg:border-r-2 border-[#8e24aa] mt-2"
        >
          <h2 class="font-bold leading-tight lg:leading-snug">
            Inicio septiembre 2025
          </h2>
        </div>

        {/* 3. Header: Middle Column (Mobile: Horarios / Desktop: Días) */}
        {/* Mobile: Order 3 (Row 3, Left) | Desktop: Order 2 (Row 1, Middle) */}
        <div
          class="col-span-1 order-3 lg:order-2 bg-[#9b36d0] text-white flex items-center justify-center py-1.5 lg:py-4"
        >
          <span class="font-bold"> Días </span>
        </div>

        {/* 4. Header: Right Column (Mobile: Días / Desktop: Horarios) */}
        {/* Mobile: Order 4 (Row 3, Right) | Desktop: Order 3 (Row 1, Right) */}
        <div
          class="col-span-1 order-4 lg:order-3 bg-[#9b36d0] text-white flex items-center justify-center py-1.5 lg:py-4"
        >
          <span class="font-bold text-lg lg:text-xl"> Horarios </span>
        </div>

        {/* 5. Content: Middle Column (Days) */}
        {/* Mobile: Order 5 (Row 4, Left) | Desktop: Order 5 (Row 2, Middle) */}
        <div
          class="col-span-1 order-5 bg-white flex flex-col justify-center gap-10 lg:gap-16 py-8 lg:py-10 border-r-2 border-[#8e24aa] relative mt-2"
        >
          {
            /* Mobile vertical divider visual fix: standard border-r works for grid item */
          }
          {
            SCHEDULES.map((item) => (
              <div class="text-center font-bold px-2">{item.days}</div>
            ))
          }
        </div>

        {/* 6. Content: Right Column (Times) */}
        {/* Mobile: Order 6 (Row 4, Right) | Desktop: Order 6 (Row 2, Right) */}
        <div
          class="col-span-1 order-6 bg-white flex flex-col justify-center px-4 gap-8 lg:gap-16 py-6 lg:py-10"
        >
          {
            SCHEDULES.map((item) => (
              <div class="text-center font-bold leading-tight px-1">
                {item.hours}
              </div>
            ))
          }
        </div>

        {/* 7. Footer: Duration */}
        {/* Mobile: Order 7 (Bottom) | Desktop: Order 7 (Row 3) */}
        <div
          class="col-span-2 lg:col-span-3 order-7 bg-white pt-2 lg:pt-5 pb-6 lg:pb-5 mb-0 lg:mb-2 text-center"
        >
          <div class="mx-6 lg:mx-10 border-t-2 border-[#7b1fa2] pt-2 lg:pt-5">
            <p class="font-bold lg:inline lg:mr-2">
              Total de duración por módulo:
            </p>
            <p
              class="text-[#ab47bc] font-bold mt-1 lg:mt-0 lg:inline lg:text-[36px]"
            >
              10 semanas <span class="text-purple-400 font-normal">/</span>
              <span class="text-[#ab47bc] font-normal lg:text-[25px]"
                >2.5 meses</span
              >
            </p>
          </div>
        </div>
      </div>
    </div>
  </Container>

  <section class="px-5 py-10 xl:py-20">
    <MLCForm formType="meet" />
  </section>
</section>

<style>
  .triangle-rotate {
    width: 100%;
    height: 100%;
    background: transparent linear-gradient(90deg, #ac76d4 0%, #44026b 100%) 0%
      0% no-repeat padding-box;
    clip-path: polygon(100% 0, 0% 100%, 100% 100%);
  }

  .description-list {
    list-style-type: none;
    margin-top: 1.5rem;
    margin-inline: 3rem;
  }
  .description-list li {
    position: relative;
    padding-left: 1rem;
    margin-bottom: 0.5rem;
  }
  .description-list li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.5rem;
    width: 7px;
    height: 7px;
    background-color: #9448c7;
    border-radius: 50%;
  }

  .benefits-list {
    list-style-type: none;
  }

  @media (width >= 64rem /* 1024px */) {
    .description-list {
      column-count: 2;
    }

    .benefits-list {
      column-count: 2;
    }

    .description-list li {
      padding-left: 2rem;
    }
    .description-list li::before {
      width: 20px;
      height: 20px;
    }
  }

  @media (width >= 80rem /* 1280px */) {
    .box-level {
      /* box-shadow: 10px 10px 38px 0px rgba(0, 0, 0, 0.75);
            -webkit-box-shadow: 10px 10px 38px 0px rgba(0, 0, 0, 0.75);
            -moz-box-shadow: 10px 10px 38px 0px rgba(0, 0, 0, 0.75); */
    }
  }
</style>
